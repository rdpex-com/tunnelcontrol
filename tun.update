#!/bin/bash
# tun.update

{
if [ -z "${DATA_PATH}" ]; then
    echo "Error: DATA_PATH environment variable is not set. Do not run this script directly."
    exit 1
fi

cd "$(dirname "$(readlink -f "$0")")" || exit 1

source ./tun.logger
source ./tun.env

MANAGER_PID=$(cat "${DATA_PATH}/tun_pid" 2>/dev/null)
if [[ $MANAGER_PID =~ ^[0-9]+$ ]] && tr '\0' '\n' 2>/dev/null < "/proc/${MANAGER_PID}/cmdline" | grep -qx './tun.manager'; then
    export TUN_UPDATE_WAS_RUNNING=1
fi

fail() {
    LOG ERROR "Update: $*"
    exit 1
}

if [ -d .git ]; then
    LOG INFO "Update: checking for a new version..."

    git fetch --quiet || fail "cannot reach the source this copy was installed from"
    UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || fail "this copy has no source to update from; it is updated where it was copied from, or reinstall with install.sh"

    if [ "$(git rev-parse HEAD)" = "$(git rev-parse "$UPSTREAM")" ]; then
        LOG NOTICE "Update: already up to date ($(cat ./VERSION 2>/dev/null))"
        exit 0
    fi

    git merge-base --is-ancestor HEAD "$UPSTREAM" || fail "this copy has changes of its own that the source does not have; it cannot be updated automatically"
    git diff --quiet HEAD || fail "files of this installation were changed by hand; restore them, then update again"

    FROM=$(cat ./VERSION 2>/dev/null)
    TO=$(git show "${UPSTREAM}:VERSION" 2>/dev/null)
    if [ "$FROM" = "$TO" ]; then
        FROM="${FROM} ($(git log -1 --format=%h))"
        TO="${TO} ($(git log -1 --format=%h "$UPSTREAM"))"
    fi

    date +%s > "${DATA_PATH}/tun_restarting"
    ./tun --stop < /dev/null > /dev/null 2>&1

    git merge --ff-only --quiet "$UPSTREAM" || fail "replacing the code failed; run tun --install to start the tunnels again"
    LOG NOTICE "Update: code updated ${FROM} -> ${TO}"
else
    [ -n "${UPDATE_URL}" ] || fail "UPDATE_URL is empty"

    CURRENT=$(cat ./VERSION 2>/dev/null || true)
    LATEST=$(curl -fsSL "${UPDATE_URL}/VERSION") || fail "cannot get the latest version from ${UPDATE_URL}/VERSION"
    [[ $LATEST =~ ^[0-9]+(\.[0-9]+)+$ ]] || fail "unexpected answer from ${UPDATE_URL}/VERSION"

    if [ "$LATEST" = "$CURRENT" ]; then
        LOG NOTICE "Update: already up to date (${CURRENT})"
        exit 0
    fi

    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT

    LOG NOTICE "Update: downloading version ${LATEST}..."
    CURL_PROGRESS=--silent
    [ -t 2 ] && CURL_PROGRESS=--progress-bar
    curl -fSL "$CURL_PROGRESS" "${UPDATE_URL}/tunnelcontrol.tar.gz" -o "$TMP/release.tar.gz" || fail "download failed"

    mkdir "$TMP/src"
    tar -xzf "$TMP/release.tar.gz" -C "$TMP/src" --strip-components=1 2>/dev/null || fail "the download is not a valid archive"
    if [ ! -f "$TMP/src/tun" ] || [ ! -f "$TMP/src/tun.defaults" ] || [ ! -d "$TMP/src/web" ]; then
        fail "the archive does not look like a Tunnel Control release"
    fi
    [ "$(cat "$TMP/src/VERSION" 2>/dev/null)" = "$LATEST" ] || fail "the archive is not version ${LATEST}"
    for USER_FILE in tun.config .data_path data bak; do
        [ -e "$TMP/src/$USER_FILE" ] && fail "the archive contains the user item ${USER_FILE}"
    done

    (cd "$TMP/src" && find . -type f -printf '%P\n' | LC_ALL=C sort) > "$TMP/release-files"

    date +%s > "${DATA_PATH}/tun_restarting"
    ./tun --stop < /dev/null > /dev/null 2>&1

    cp -a "$TMP/src/." ./ || fail "copying the new code failed; run tun --install to start the tunnels again"

    if [ -f .release-files ]; then
        REMOVED=0
        while IFS= read -r OLD_FILE; do
            case $OLD_FILE in
                ""|/*|*..*|tun.config|.data_path|data/*|bak/*|tun.server.setup.[0-9]*) continue ;;
            esac
            [ -e "$TMP/src/$OLD_FILE" ] && continue
            if [ -f "$OLD_FILE" ]; then
                rm -f -- "$OLD_FILE" && REMOVED=$((REMOVED + 1))
                rmdir -p --ignore-fail-on-non-empty "$(dirname "$OLD_FILE")" 2>/dev/null || true
            fi
        done < <(LC_ALL=C comm -23 <(LC_ALL=C sort .release-files) "$TMP/release-files")
        [ "$REMOVED" -gt 0 ] && LOG NOTICE "Update: removed ${REMOVED} file(s) that left the release"
    fi
    cp "$TMP/release-files" .release-files
    rm -rf "$TMP"
    LOG NOTICE "Update: code updated ${CURRENT:-unknown} -> ${LATEST}"
fi

export TUN_UPDATE=1
exec ./tun --install
}
