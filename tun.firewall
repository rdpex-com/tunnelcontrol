#!/bin/bash

if [ -z "${DATA_PATH}" ]; then
    echo "Error: DATA_PATH environment variable is not set. Do not run this script directly."
    exit 1
fi

CONFIG=${1}

source ./tun.logger

IFS=':' read -r IFACE NETWORK <<< "$CONFIG"

LOG INFO "Applying GLOBAL firewall + base rules for ${IFACE}:${NETWORK}"

# === SAFE CLEANUP ===
# Remove only our own rules (local and main are left alone)
ip rule del iif "${IFACE}" table 100 2>/dev/null || true
ip rule del iif "${IFACE}" table 200 2>/dev/null || true
ip rule del iif "${IFACE}" table 300 2>/dev/null || true

while ip rule del priority 50 2>/dev/null; do :; done
while ip rule del priority 51 2>/dev/null; do :; done
ip rule del table 100 2>/dev/null || true
ip rule del table 200 2>/dev/null || true
ip rule del table 300 2>/dev/null || true

while ip rule del priority 90 2>/dev/null; do :; done
while ip rule del priority 91 2>/dev/null; do :; done
while ip rule del priority 101 2>/dev/null; do :; done

# Flush only our own routing tables
ip route flush table 50 2>/dev/null || true
ip route flush table 51 2>/dev/null || true

ip route flush table 100 2>/dev/null || true
ip route flush table 200 2>/dev/null || true
ip route flush table 300 2>/dev/null || true
for id in $(ip nexthop show 2>/dev/null | awk '$1 == "id" && $2 >= 3000 && $2 < 4000 {print $2}' | sort -n); do
    ip nexthop del id "$id" 2>/dev/null || true
done

# Exceptions (high priority)
ip rule add from all to "${NETWORK}" table main priority 50 2>/dev/null || true
# Traffic from clients on interface ${IFACE}
ip rule add iif "${IFACE}" table 300 priority 100 2>/dev/null || true
ip rule add iif "${IFACE}" priority 101 unreachable 2>/dev/null || true
# All other outgoing traffic (from the server itself too)
ip rule add from all table 300 priority 200 2>/dev/null || true

# === FULL RESET ===
iptables -F
iptables -X
iptables -t nat -F
iptables -t nat -X
iptables -t mangle -F
iptables -t mangle -X
iptables -t raw -F
iptables -t raw -X
iptables -Z

# === DEFAULT POLICIES ===
iptables -P INPUT DROP
iptables -P OUTPUT DROP
iptables -P FORWARD DROP

# === LOOPBACK ===
iptables -A INPUT  -i lo -j ACCEPT
iptables -A OUTPUT -o lo -j ACCEPT

iptables -A FORWARD -s 10.0.0.0/8 -d 10.0.0.0/8 -j DROP

# === CLIENT TRAFFIC ONLY THROUGH TUNNELS ===
# If all tunnels are down, client traffic must not go out directly
# (FORWARD from clients back out of ${IFACE} is dropped when no tunnel is active)
iptables -A FORWARD -i "${IFACE}" -o "${IFACE}" -j DROP

# === ESTABLISHED, RELATED ===
iptables -A INPUT   -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT  -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

iptables -A FORWARD -i "${IFACE}" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A FORWARD -o "${IFACE}" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# === SSH to server B ===
iptables -A INPUT -i "${IFACE}" -p tcp --dport 22 -j ACCEPT

# === Server B itself has direct internet access ===
iptables -A OUTPUT -o "${IFACE}" -j ACCEPT
iptables -A OUTPUT -o tun+ -m conntrack --ctstate NEW -j ACCEPT

# === Client access to local services on B ===
iptables -A INPUT  -i "${IFACE}" -s "${NETWORK}" -j ACCEPT
iptables -A OUTPUT -d "${NETWORK}" -j ACCEPT

# === ICMP ===
iptables -A INPUT  -p icmp -j ACCEPT
iptables -A OUTPUT -p icmp -j ACCEPT
iptables -A FORWARD -i "${IFACE}" -o tun+ -p icmp -j ACCEPT

# === TCP MSS clamping (global for all tunnels) ===
iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

LOG INFO "GLOBAL rules applied successfully"