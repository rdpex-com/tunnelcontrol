#!/bin/bash

TUN_ENV_PREFIXES='LOG|MANAGER|TUNNEL|ROTATION|SHAPING|WEB|UPDATE'

source ./tun.defaults

declare -A TUN_ENV_DEFAULTS
for TUN_ENV_NAME in $(grep -oE "^(${TUN_ENV_PREFIXES})_[A-Z0-9_]+=" ./tun.defaults | tr -d '='); do
    TUN_ENV_DEFAULTS[$TUN_ENV_NAME]=${!TUN_ENV_NAME}
done

if [ -f ./tun.config ]; then
    eval "$(grep -E "^[[:space:]]*(${TUN_ENV_PREFIXES})_[A-Z0-9_]+=(\"[^\"\$\`\\\\]*\"|'[^']*'|[A-Za-z0-9._:/+-]*)([[:space:]]+#.*)?[[:space:]]*\$" ./tun.config)"
fi

for TUN_ENV_NAME in "${!TUN_ENV_DEFAULTS[@]}"; do
    if [[ ${TUN_ENV_DEFAULTS[$TUN_ENV_NAME]} =~ ^[0-9]+$ ]] && ! [[ ${!TUN_ENV_NAME} =~ ^[0-9]+$ ]]; then
        [ "${1:-}" = "check" ] && LOG WARN "Setting ${TUN_ENV_NAME}='${!TUN_ENV_NAME}' is not a number, using default ${TUN_ENV_DEFAULTS[$TUN_ENV_NAME]}"
        printf -v "$TUN_ENV_NAME" '%s' "${TUN_ENV_DEFAULTS[$TUN_ENV_NAME]}"
    fi
done

if [ "${1:-}" = "check" ]; then
    for TUN_ENV_NAME in $(printf '%s\n' "${!TUN_ENV_DEFAULTS[@]}" | sort); do
        if [ "${!TUN_ENV_NAME}" != "${TUN_ENV_DEFAULTS[$TUN_ENV_NAME]}" ]; then
            LOG INFO "Setting ${TUN_ENV_NAME}=${!TUN_ENV_NAME} (default ${TUN_ENV_DEFAULTS[$TUN_ENV_NAME]})"
        fi
    done
fi

unset TUN_ENV_NAME
