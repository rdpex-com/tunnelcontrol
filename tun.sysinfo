#!/bin/bash

if [[ "$1" == "once" || "$1" == "-1" || "$1" == "--once" ]]; then
    if ! GUESTINFO=$(LC_ALL=C.UTF-8 vmtoolsd --cmd "info-get guestinfo.sysinfo" 2>/dev/null) || [[ "$GUESTINFO" == *"No value found"* ]] || [ -z "$GUESTINFO" ]; then
        GUESTINFO="No data from host"
    else
        GUESTINFO=$(echo "$GUESTINFO" | \
                    grep -oE '[^|]*[0-9.+-]+°C' | \
                    sed 's/^[ \t]*//;s/[ \t]*$//' | \
                    tr '\n' '|' | \
                    sed 's/|$//' | \
                    sed 's/|/ | /g')
    fi

    read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 _ < /proc/stat
    sleep 0.5
    read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ < /proc/stat
    cpu_load=$(awk -v busy=$(( (u2 + n2 + s2 + q2 + sq2 + st2) - (u1 + n1 + s1 + q1 + sq1 + st1) )) -v idle=$(( (i2 + w2) - (i1 + w1) )) \
        'BEGIN { total = busy + idle; printf "%.1f", (total > 0 ? busy * 100 / total : 0) }')
    ram=$(free | awk '/^Mem:/ {
        used = $3;
        total = $2;
        pct = int(used * 100 / total);

        if (used >= 1048576) {
            u = sprintf("%.1fG", used / 1048576);
        } else if (used >= 1024) {
            u = sprintf("%dM", used / 1024);
        } else {
            u = used "K";
        }

        if (total >= 1048576) {
            t = sprintf("%.1fG", total / 1048576);
        } else if (total >= 1024) {
            t = sprintf("%dM", total / 1024);
        } else {
            t = sprintf("%dK", total);
        }

        printf "%s/%s (%d%%)", u, t, pct;
    }')
    disk=$(df -h / | awk 'NR==2 {printf "%s/%s (%s)", $3, $2, $5}')

    dir=$(dirname "$(readlink -f "$0")")
    data=$(cat "${dir}/.data_path" 2>/dev/null || echo ./data)
    [[ $data == /* ]] || data="${dir}/${data#./}"
    latest=$(cat "${data}/tun_latest_version" 2>/dev/null)
    current=$(cat "${dir}/VERSION" 2>/dev/null)
    update=""
    if [[ $latest =~ ^[0-9]+(\.[0-9]+)+$ ]] && [ "$latest" != "$current" ] \
        && [ "$(printf '%s\n' "$current" "$latest" | sort -V | tail -n 1)" = "$latest" ]; then
        update=" | Update: ${latest} available, run tun --update"
    fi

    printf "CPU: %s%% | RAM: %s | Disk: %s | %s%s\n" \
        "$cpu_load" "$ram" "$disk" "$GUESTINFO" "$update"
else
    watch -n 1 --no-title --color "$0 --once"
fi