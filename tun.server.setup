#!/bin/bash
# tun.server.setup <host> <port> <port_range> <in_face> <public_ip> <out_face> <cipher>

if [ -z "${DATA_PATH}" ]; then
    echo "Error: DATA_PATH environment variable is not set. Do not run this script directly."
    exit 1
fi

HOST=${1}
PORT=${2}
PORT_RANGE=${3}
IN_FACE=${4}
PUBLIC_IP=${5}
OUT_FACE=${6}
CIPHER=${7}
PASSWORD=""
{ IFS= read -r PASSWORD <&3 || true; } 2>/dev/null
exec 3<&-
SETUP_ARGS=("$@")

source ./tun.logger

set -euo pipefail

LOG INFO "Configuring host $HOST"

trap '' TSTP
SETUP_TMP=""
trap '[ -n "$SETUP_TMP" ] && rm -f "$SETUP_TMP"' EXIT
trap 'exit 143' TERM

if [[ ! -t 0 ]]; then
    trap '' TTIN TTOU
fi

CONFIG_MARKER="${DATA_PATH}/tun_host_${HOST}_configured"
LOAD_MARKER="${DATA_PATH}/tun_host_${HOST}_loaded"
HOST_EXIT_CODE="${DATA_PATH}/tun_ssh_exit_code_${HOST}"
KNOWN_HOSTS="${DATA_PATH}/known_hosts"

SESSION=$(cat "${DATA_PATH}/tun_session" 2>/dev/null || true)
[[ $SESSION =~ ^[0-9a-f]+$ ]] || SESSION=none

RUN_DIR="/run/tunnelcontrol"
SESSION_FILE="${RUN_DIR}/session"

BUSY_CHECK='owner=$(cat '"${SESSION_FILE}"' 2>/dev/null)
job=$(cat '"${RUN_DIR}"'/setup.pid 2>/dev/null)
if [ -n "$owner" ] && [ "$owner" != "'"${SESSION}"'" ] && { compgen -G "/sys/class/net/tun[0-9]*" > /dev/null || { [ -n "$job" ] && tr "\0" " " 2>/dev/null < /proc/$job/cmdline | grep -q "^bash '"${RUN_DIR}"'/setup.job "; }; }; then
    echo "VPS-BUSY: $(date -r '"${SESSION_FILE}"' "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null)|$(echo "$owner" | cut -c1-8)"
    exit 0
fi'

write_file() {
    local tmp="${1%/*}/.${1##*/}.tmp"
    printf '%s\n' "$2" > "$tmp" && mv -f "$tmp" "$1"
}

hold_host() {
    local reason=$1 code=$2 message=$3 notice=${4:-$3}

    LOG ERROR "$message"
    rm -f "$LOAD_MARKER" 2>/dev/null || true
    write_file "${HOST_EXIT_CODE}" "$code"
    printf '%s\n%s\n' "$reason" "$message" > "${DATA_PATH}/tun_host_${HOST}_held"
    if [ "${WEB_PANEL:-1}" != "0" ] && [ "${WEB_PUSH:-1}" != "0" ]; then
        mkdir -p "${DATA_PATH}/queue"
        echo "$notice" > "${DATA_PATH}/queue/message_$(date +%s%N).notify"
    fi
}

busy_refused() {
    local since mark

    grep -q '^VPS-BUSY' <<< "$1" || return 1
    IFS='|' read -r since mark < <(sed -n 's/^VPS-BUSY: //p' <<< "$1")
    [[ $mark =~ ^[0-9a-f]+$ ]] || mark=unknown

    if [ -z "${TUN_BUSY_RETRY:-}" ]; then
        LOG NOTICE "Host $HOST answers that another Tunnel Control server (session mark ${mark}) uses it; after a crash of this server its own old sessions stay there up to 30 seconds, asking again in 60 seconds"
        for _ in {1..60}; do
            [ -f "${DATA_PATH}/tun_stop" ] && exit 1
            sleep 1
        done
        export TUN_BUSY_RETRY=1
        exec "$0" "${SETUP_ARGS[@]}" 3<<< "$PASSWORD"
    fi

    hold_host busy 6 "Host $HOST is used by another Tunnel Control server (session mark ${mark}) since ${since:-unknown}; its tunnels stay off until the tunnels are restarted" \
        "Host $HOST is used by another Tunnel Control server since ${since:-unknown}; its tunnels stay off until the tunnels are restarted"
    return 0
}

validate_results() {
    SSH_EXIT_CODE=$1
    RESULT=$2
    VALIDATION_PATTERN=$3

    if [ "$SSH_EXIT_CODE" -ne 0 ]; then
        LOG ERROR "SSH connection to $HOST:$PORT failed with code $SSH_EXIT_CODE"

        if [ "$SSH_EXIT_CODE" -eq 255 ]; then
            LOG ERROR "$(grep -v '^Warning: Permanently added' <<< "$RESULT" | tail -n 1)"
        else
            LOG ERROR "The start script on $HOST ended with code $SSH_EXIT_CODE"
        fi

        if echo "$RESULT" | grep -qE 'Host key verification failed|IDENTIFICATION HAS CHANGED'; then
            LOG ERROR "Host key of $HOST does not match ${KNOWN_HOSTS}. If the VPS was reinstalled, remove the old key: ssh-keygen -R $HOST -f ${KNOWN_HOSTS}"
        fi

        write_file "${HOST_EXIT_CODE}" "${SSH_EXIT_CODE}"

        return 1
    else
        LOG INFO "SSH session to $HOST:$PORT established successfully"

        if echo "$RESULT" | grep -q "$VALIDATION_PATTERN"; then
            LOG INFO "Successfully ($VALIDATION_PATTERN) on $HOST"

            rm -f "${HOST_EXIT_CODE}" 2>/dev/null || true
            return 0
        else
            LOG ERROR "Failed to validate result on $HOST. Output: $RESULT"

            write_file "${HOST_EXIT_CODE}" -1
            return 1
        fi
    fi
}

ssh_with_pass() {
    LOG INFO "Connecting to $HOST:$PORT with password authentication"

    sshpass -d 4 ssh \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=3 \
        -o TCPKeepAlive=yes \
        -o Compression=yes \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="${KNOWN_HOSTS}" \
        -o HostKeyAlias="${HOST}" \
        -o PreferredAuthentications=keyboard-interactive,password \
        -c "$CIPHER" \
        -p "$PORT" \
        root@"$HOST" "$@" 4<<< "$PASSWORD"
}

ssh_with_key() {
    LOG INFO "Connecting to $HOST:$PORT with key authentication"

    ssh -T \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=3 \
        -o TCPKeepAlive=yes \
        -o Compression=yes \
        -o BatchMode=yes \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="${KNOWN_HOSTS}" \
        -o HostKeyAlias="${HOST}" \
        -i /root/.ssh/id_ed25519_tun \
        -c "$CIPHER" \
        -p "$PORT" \
        root@"$HOST" "$@"
}

vps_progress() {
    local out=$1 line pct verb eta label="package lists" value modules=""
    local eta_re='\(([^)]*remaining)\)'
    local -a field
    clear_line() {
        [ -t 1 ] && printf '\r\033[K'
        return 0
    }
    while IFS= read -r line; do
        IFS=: read -ra field <<< "$line"
        case "${field[0]:-}" in
            dlstatus) verb=Downloading; pct=${field[2]:-} ;;
            pmstatus) verb=Installing; pct=${field[2]:-}; [[ $pct =~ ^[0-9] ]] || pct=${field[3]:-} ;;
            *)
                echo "$line" >> "$out"
                value=${line#*: }
                case "$line" in
                    JOB-STEP:*)
                        clear_line
                        [ -t 1 ] && printf 'VPS %s: setup: %s\n' "$HOST" "$value"
                        ;;
                    JOB-ATTACH:*)
                        clear_line
                        LOG NOTICE "VPS $HOST: a setup started earlier is still running, waiting for it"
                        ;;
                    "JOB-KEY: added")
                        clear_line
                        LOG NOTICE "VPS $HOST: the key of this server is installed"
                        ;;
                    "JOB-SSHD: applied")
                        clear_line
                        LOG NOTICE "VPS $HOST: sshd settings applied (keepalive, PermitTunnel)"
                        ;;
                    "JOB-SSHD: reloaded")
                        clear_line
                        LOG NOTICE "VPS $HOST: sshd restarted, its configuration had changed since it started"
                        ;;
                    "JOB-DPKG: repaired")
                        clear_line
                        LOG WARN "VPS $HOST: dpkg had been interrupted, finished it with dpkg --configure -a"
                        ;;
                    "JOB-DPKG: failed")
                        clear_line
                        LOG WARN "VPS $HOST: dpkg had been interrupted and dpkg --configure -a failed"
                        ;;
                    JOB-MODULES:*)
                        modules=$value
                        ;;
                    JOB-NOAPT:*)
                        clear_line
                        LOG WARN "VPS $HOST: ${value} missing and no apt-get to install them"
                        ;;
                    "JOB-NOMODULES: installed "*)
                        clear_line
                        LOG WARN "VPS $HOST: kernel modules ${modules} missing; linux-modules-extra-${value#installed } does not have them"
                        ;;
                    "JOB-NOMODULES: absent "*)
                        clear_line
                        LOG WARN "VPS $HOST: kernel modules ${modules} missing and apt has no linux-modules-extra-${value#absent }"
                        ;;
                    JOB-INSTALL:*)
                        label=$value
                        ;;
                    JOB-INSTALLED:*)
                        clear_line
                        if [ "$value" = "0" ]; then
                            LOG NOTICE "VPS $HOST: installed ${label}"
                        else
                            LOG WARN "VPS $HOST: installing ${label} failed (apt-get exit code ${value})"
                        fi
                        ;;
                esac
                continue
                ;;
        esac
        [ -t 1 ] || continue
        [[ $pct =~ ^[0-9] ]] || continue
        eta=""
        [[ $line =~ $eta_re ]] && eta=" (${BASH_REMATCH[1]})"
        printf '\r\033[KVPS %s: %s %s: %s%%%s' "$HOST" "$verb" "$label" "${pct%%.*}" "$eta"
    done
    clear_line
    return 0
}

job_value() {
    sed -n "s/^$1: //p" <<< "$JOB_RESULT" | tail -n 1
}

run_vps_setup() {
    local method=$1
    SETUP_TMP=$(mktemp)
    set +e
    if [ "$method" = "password" ]; then
        ssh_with_pass "SESSION=${SESSION} PUBKEY='$(cat /root/.ssh/id_ed25519_tun.pub)'
$(cat ./tun.server.setup.vps)" < ./tun.server.setup.job 2>&1 | vps_progress "$SETUP_TMP"
    else
        ssh_with_key "SESSION=${SESSION} PUBKEY='$(cat /root/.ssh/id_ed25519_tun.pub)'
$(cat ./tun.server.setup.vps)" < ./tun.server.setup.job 2>&1 | vps_progress "$SETUP_TMP"
    fi
    JOB_EXIT=${PIPESTATUS[0]}
    set -e
    JOB_RESULT=$(cat "$SETUP_TMP")
    rm -f "$SETUP_TMP"
    SETUP_TMP=""
}

run_vps_setup key

if busy_refused "$JOB_RESULT"; then
    exit 1
fi

if [ "$JOB_EXIT" -ne 0 ] && grep -q "Permission denied" <<< "$JOB_RESULT"; then
    WAS_CONFIGURED=""
    [ -f "$CONFIG_MARKER" ] && WAS_CONFIGURED=1
    rm -f "$CONFIG_MARKER"
    if [[ -z "$PASSWORD" ]]; then
        if [ -n "$WAS_CONFIGURED" ]; then
            hold_host setup 7 "Host $HOST no longer accepts the key of this server (was the VPS reinstalled?) and needs its first setup again: run tun --install again, it asks for the root password now"
        else
            hold_host setup 7 "Host $HOST needs its first setup with the root password: run tun --install"
        fi
        exit 1
    fi
    LOG NOTICE "First time setup for $HOST: installing the key, sshd settings and packages"
    run_vps_setup password
    if busy_refused "$JOB_RESULT"; then
        exit 1
    fi
    if [ "$JOB_EXIT" -eq 5 ]; then
        hold_host password 5 "Host $HOST rejected the root password: its tunnels stay off until tun --install is run with the right password"
        exit 1
    fi
    if [ "$JOB_EXIT" -ne 0 ] && grep -q "Permission denied" <<< "$JOB_RESULT"; then
        hold_host password 5 "Host $HOST does not let root log in with a password (PermitRootLogin prohibit-password or PasswordAuthentication no in its sshd settings): allow it once, or put the key from /root/.ssh/id_ed25519_tun.pub of this server into /root/.ssh/authorized_keys on the VPS by hand, then run tun --install"
        exit 1
    fi
fi

LOG DEBUG "VPS setup output: $JOB_RESULT"

JOB_INSTALL=$(job_value JOB-INSTALL)
JOB_DONE=$(job_value JOB-DONE)
if [ -z "$JOB_DONE" ]; then
    if grep -qE 'Host key verification failed|IDENTIFICATION HAS CHANGED' <<< "$JOB_RESULT"; then
        LOG ERROR "Host key of $HOST does not match ${KNOWN_HOSTS}. If the VPS was reinstalled, remove the old key: ssh-keygen -R $HOST -f ${KNOWN_HOSTS}"
    elif ! grep -q '^JOB-' <<< "$JOB_RESULT"; then
        LOG ERROR "VPS $HOST: cannot reach it to run the setup (ssh exit code ${JOB_EXIT}): $(grep -v '^\[' <<< "$JOB_RESULT" | tail -n 1)"
    elif [ -n "$JOB_INSTALL" ]; then
        LOG WARN "VPS $HOST: the link broke while installing ${JOB_INSTALL}; the setup goes on there and the next attempt waits for it"
    else
        LOG WARN "VPS $HOST: the link broke during the setup; it goes on there and the next attempt waits for it"
    fi
    write_file "${HOST_EXIT_CODE}" 255
    exit 1
fi

if [ "$JOB_DONE" != "0" ]; then
    JOB_FAIL=$(sed -n 's/^JOB-FAIL: //p' <<< "$JOB_RESULT" | paste -sd ';')
    [ -n "$JOB_FAIL" ] || JOB_FAIL="the setup step $(job_value JOB-STEP) failed without a message"
    hold_host vps 8 "Host $HOST cannot run tunnels: ${JOB_FAIL}. Fix the VPS, then restart the tunnels"
    exit 1
fi

if [[ ! -f "$CONFIG_MARKER" ]]; then
    touch "$CONFIG_MARKER"
    LOG NOTICE "Initial setup completed successfully on $HOST"
fi

rm -f "$LOAD_MARKER" 2>/dev/null || true

SETUP_FILE="./tun.server.setup.${HOST}"

if [[ -f "$SETUP_FILE" ]]; then
    if grep -q $'\r' "$SETUP_FILE"; then
        hold_host file 8 "tun.server.setup.${HOST} has Windows line endings (CR) and cannot run on the VPS: convert it with sed -i 's/\r\$//' tun.server.setup.${HOST}, then restart the tunnels; the tunnels of $HOST stay off until then" \
            "Host $HOST is held off: tun.server.setup.${HOST} has Windows line endings (CR)"
        exit 1
    fi

    LOG INFO "Found custom setup for $HOST — injecting tun.server.setup.${HOST}"

    SETUP_CONTENT=$(cat "$SETUP_FILE")
    [[ "${SETUP_CONTENT: -1}" != $'\n' ]] && SETUP_CONTENT+=$'\n'

    FULL_SCRIPT=$(SETUP_CONTENT="$SETUP_CONTENT" awk '
        /### tun\.setup ###/ {
            printf "%s", ENVIRON["SETUP_CONTENT"]
            next
        }
        { print }
    ' ./tun.server)
else
    LOG INFO "Using default tun.server for $HOST"
    FULL_SCRIPT=$(cat ./tun.server)
fi

VPS_LOG=${LOG_VPS_FILE:-/var/log/tun.log}
if ! [[ $VPS_LOG =~ ^/[A-Za-z0-9._/+-]+$ ]] || [[ $VPS_LOG == */ ]]; then
    LOG WARN "LOG_VPS_FILE='${VPS_LOG}' is not an absolute file path of letters, digits and . _ / + -, using /var/log/tun.log"
    VPS_LOG=/var/log/tun.log
fi
FULL_SCRIPT=$(VPS_LOG="$VPS_LOG" VPS_LOG_MAX_KB="${LOG_VPS_MAX_KB:-1024}" awk '
    $0 == "LOG=\"/var/log/tun.log\"" {
        print "LOG=\"" ENVIRON["VPS_LOG"] "\""
        next
    }
    $0 == "LOG_MAX_KB=1024" {
        print "LOG_MAX_KB=" ENVIRON["VPS_LOG_MAX_KB"]
        next
    }
    { print }
' <<< "$FULL_SCRIPT")

set +e
RESULT=$(echo "$FULL_SCRIPT" | ssh_with_key \
    "${BUSY_CHECK}
     mkdir -p ${RUN_DIR} &&
     echo ${SESSION} > ${SESSION_FILE} &&
     cat > ${RUN_DIR}/tun.start &&
     rm -f ${RUN_DIR}/initialized ${RUN_DIR}/setup.pid ${RUN_DIR}/setup.log ${RUN_DIR}/setup.job ${RUN_DIR}/prepare.pid ${RUN_DIR}/prepare.log ${RUN_DIR}/sshd_restart /tmp/tun.start /tmp/tun_initialized /tmp/tun_busy /tmp/ssd_restart &&
     exec bash ${RUN_DIR}/tun.start 0 ${IN_FACE} ${PORT} ${PORT_RANGE} ${PUBLIC_IP} ${OUT_FACE}" 2>&1)
EXIT_CODE=$?
set -e

if busy_refused "$RESULT"; then
    exit 1
fi

while IFS= read -r PROBLEM; do
    LOG WARN "VPS ${HOST}: ${PROBLEM#VPS-PROBLEM: }"
done < <(grep '^VPS-PROBLEM: ' <<< "$RESULT")

FATAL=$(sed -n 's/^VPS-FATAL: //p' <<< "$RESULT")
if [ -n "$FATAL" ]; then
    hold_host vps 8 "Host $HOST cannot run tunnels: ${FATAL//$'\n'/; }. Fix the VPS, then restart the tunnels"
    exit 1
fi

if ! validate_results "$EXIT_CODE" "$RESULT" "Loaded"; then
    LOG ERROR "Failed to start tun.server on $HOST. Output: $RESULT"
    exit 1
else
    touch "$LOAD_MARKER"
    LOG INFO "tun.server started successfully on $HOST"
fi