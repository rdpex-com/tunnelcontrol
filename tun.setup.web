#!/bin/bash

if [ -z "${DATA_PATH}" ]; then
    echo "Error: DATA_PATH environment variable is not set. Do not run this script directly."
    exit 1
fi

WORKING_DIR="${1:-$(dirname "$(readlink -f "$0")")}"
SERVICE_NAME="tun-web.service"
SYSTEMD_PATH="/etc/systemd/system/${SERVICE_NAME}"
SERVICE_FILE="${WORKING_DIR}/${SERVICE_NAME}"

CERT_PATH="${DATA_PATH}/cert"

NODE_MIN_MAJOR=20
NODE_INSTALL_MAJOR=22

source ./tun.logger
source ./tun.env

apt_lock_busy() {
    local lock
    for lock in /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend; do
        [ -e "$lock" ] && grep -q ":$(stat -c %i "$lock") " /proc/locks && return 0
    done
    return 1
}

apt_progress() {
    local label=$1 line pct verb eta status log
    local eta_re='\(([^)]*remaining)\)'
    local -a field
    shift
    if [ "${1:-}" = update ]; then
        local waited=0
        while [ "$waited" -lt 300 ] && apt_lock_busy; do
            sleep 5
            waited=$((waited + 5))
        done
    fi
    log=$(mktemp)
    if [ ! -t 1 ]; then
        DEBIAN_FRONTEND=noninteractive apt-get -qq -o DPkg::Lock::Timeout=300 "$@" > "$log" 2>&1
        status=$?
        APT_OUTPUT=$(tail -n 5 "$log")
        rm -f "$log"
        return "$status"
    fi
    DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 -o APT::Status-Fd=3 "$@" 3>&1 > "$log" 2>&1 | while IFS= read -r line; do
        IFS=: read -ra field <<< "$line"
        case "${field[0]:-}" in
            dlstatus) verb=Downloading; pct=${field[2]:-} ;;
            pmstatus) verb=Installing; pct=${field[2]:-}; [[ $pct =~ ^[0-9] ]] || pct=${field[3]:-} ;;
            *) continue ;;
        esac
        [[ $pct =~ ^[0-9] ]] || continue
        eta=""
        [[ $line =~ $eta_re ]] && eta=" (${BASH_REMATCH[1]})"
        printf '\r\033[K%s %s: %s%%%s' "$verb" "$label" "${pct%%.*}" "$eta"
    done
    status=${PIPESTATUS[0]}
    printf '\r\033[K'
    APT_OUTPUT=$(tail -n 5 "$log")
    rm -f "$log"
    return "$status"
}

apt_install() {
    if ! apt_progress "package lists" update; then
        LOG WARN "apt-get update failed, installing with the current package lists: ${APT_OUTPUT}"
    fi
    if ! apt_progress "$*" install -y "$@"; then
        LOG ERROR "apt-get install $* failed: ${APT_OUTPUT}"
        return 1
    fi
}

npm_install() {
    local log pid status count total package
    local -a packages
    log=$(mktemp)
    rm -rf "${WORKING_DIR}/web/node_modules"
    (cd "${WORKING_DIR}/web" && exec npm ci --omit=dev --no-audit --no-fund) > "$log" 2>&1 &
    pid=$!
    if [ -t 1 ]; then
        mapfile -t packages < <(cd "${WORKING_DIR}/web" && node -e 'for (const [name, entry] of Object.entries(require("./package-lock.json").packages)) if (name && !entry.dev) console.log(name)' 2>/dev/null)
        total=${#packages[@]}
        while kill -0 "$pid" 2>/dev/null; do
            count=0
            for package in "${packages[@]}"; do
                [ -f "${WORKING_DIR}/web/${package}/package.json" ] && count=$((count + 1))
            done
            [ "$total" -gt 0 ] && printf '\r\033[KInstalling web panel packages: %d%%' $((count * 100 / total))
            sleep 1
        done
        printf '\r\033[K'
    fi
    wait "$pid"
    status=$?
    NPM_OUTPUT=$(cat "$log")
    rm -f "$log"
    return "$status"
}

NODE_MAJOR=$(node -v 2>/dev/null | sed -n 's/^v\([0-9]*\).*/\1/p')
if [ "${NODE_MAJOR:-0}" -lt "${NODE_MIN_MAJOR}" ]; then
    LOG NOTICE "Installing Node.js ${NODE_INSTALL_MAJOR} from NodeSource (installed: ${NODE_MAJOR:-none}, required: ${NODE_MIN_MAJOR}+)..."
    if ! apt_install curl gnupg ca-certificates; then
        LOG ERROR "Failed to install curl, gnupg and ca-certificates"
        exit 1
    fi
    mkdir -p /etc/apt/keyrings
    if ! curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
            | gpg --dearmor --yes -o /etc/apt/keyrings/nodesource.gpg; then
        LOG ERROR "Failed to get the NodeSource signing key"
        exit 1
    fi
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_INSTALL_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list
    if ! apt_install nodejs; then
        LOG ERROR "Failed to install Node.js from NodeSource"
        exit 1
    fi
fi

if ! command -v npm > /dev/null 2>&1 && ! apt_install npm; then
    LOG ERROR "Failed to install npm"
    exit 1
fi

if ! command -v openssl > /dev/null 2>&1 && ! apt_install openssl; then
    LOG ERROR "Failed to install openssl"
    exit 1
fi

NPM_STAMP="${WORKING_DIR}/web/node_modules/.tunnelcontrol-installed"
NPM_WANTED="$(sha256sum "${WORKING_DIR}/web/package-lock.json" | cut -d' ' -f1) $(node -v)"
if [ -d "${WORKING_DIR}/web/node_modules" ] && [ "$(cat "$NPM_STAMP" 2>/dev/null)" = "$NPM_WANTED" ]; then
    LOG INFO "Web panel packages are up to date (Node.js $(node -v))"
else
    LOG NOTICE "Installing web panel packages (Node.js $(node -v))..."
    if ! npm_install; then
        LOG ERROR "npm ci failed: $(echo "${NPM_OUTPUT}" | tail -n 5)"
        exit 1
    fi
    echo "$NPM_WANTED" > "$NPM_STAMP"
fi

if [ ! -f "${CERT_PATH}/ca.key" ] && [ -f "${CERT_PATH}/privkey.pem" ] && [ -f "${CERT_PATH}/fullchain.pem" ]; then
    LOG NOTICE "The web panel keeps its single self-signed certificate, which Firefox does not accept; tun --web-cert replaces it with a certificate authority and a site certificate (install the new certificate on the devices again)"
else
    if [ -f "${CERT_PATH}/ca.key" ]; then
        ./tun.web.cert renew
    else
        ./tun.web.cert create
    fi
    CERT_RESULT=$?
    if [ "$CERT_RESULT" -ne 0 ] && [ "$CERT_RESULT" -ne 3 ]; then
        exit 1
    fi
fi

LOG INFO "Installing service ${SERVICE_NAME}..."

rm -f "${SYSTEMD_PATH}"
sed "s|@DIR@|${WORKING_DIR}|g" "${SERVICE_FILE}" > "${SYSTEMD_PATH}" || { LOG ERROR "Failed to write ${SYSTEMD_PATH}"; exit 1; }

systemctl daemon-reload || { LOG ERROR "systemctl daemon-reload failed"; exit 1; }
systemctl enable "${SERVICE_NAME}" || { LOG ERROR "Failed to enable ${SERVICE_NAME}"; exit 1; }
systemctl restart "${SERVICE_NAME}" || { LOG ERROR "Failed to start ${SERVICE_NAME}"; exit 1; }

LOG NOTICE "Service ${SERVICE_NAME} installed, enabled and started."
LOG INFO "Working directory: ${WORKING_DIR}"