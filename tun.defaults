#!/bin/bash
# Default values of the internal settings.
# Do not edit this file: to change a setting, add a line with it to tun.config,
# for example ROTATION_MIN_UNIQUE_HOSTS=1. Changes apply when the tunnels start or restart (tun --restart or
# Restart in the web panel); the web panel restarts with them when a WEB_* setting or LOG_LEVEL changed.

# ---------- LOG ----------
LOG_LEVEL=1                          # 0 = errors and warnings only, 1 = plus key events (install, start and stop, VPS setup, update), 2 = plus all other messages in /var/log/tun.verbose.log and the total traffic log, 3 = plus debug messages, the web panel request log and the traffic accounting logs
LOG_VPS_FILE="/var/log/tun.log"      # log file on every VPS; /tmp/tun.log leaves nothing behind after a VPS reboot
LOG_VPS_MAX_KB=1024                  # each setup of a VPS trims its log larger than this to its last half, KB; 0 = never trim

# ---------- MANAGER ----------
MANAGER_WARN_THROTTLE=30             # seconds between repeated warnings and host reconfiguration attempts
MANAGER_WATCHDOG=true                # true = watch the manager and restart it, false = do not watch
MANAGER_SETUP_TIMEOUT=900            # seconds one VPS setup may take (package install included) before it is stopped and retried; at least 120
MANAGER_STOP_TIMEOUT=60              # how many seconds tun --stop waits for the tunnels to stop (must be less than TimeoutStopSec in tun.service)

# ---------- TUNNEL ----------
TUNNEL_CIPHER="chacha20-poly1305@openssh.com"  # ssh cipher for the tunnels and the VPS setup
TUNNEL_MTU=1400                      # MTU of the tunN interfaces on both sides
TUNNEL_CONNECT_TIMEOUT=10            # seconds to establish an ssh connection
TUNNEL_ALIVE_INTERVAL=10             # ssh keepalive check interval, seconds
TUNNEL_ALIVE_COUNT=3                 # how many unanswered checks in a row before disconnecting
TUNNEL_RETRY_DELAY=30                # pause before reconnecting after a failure, seconds
TUNNEL_CMD_TIMEOUT=15                # timeout of commands run on the VPS over the open connection, seconds
TUNNEL_PINGPONG_INTERVAL=10          # base ping-pong interval, the actual one is random from N to 2N seconds
TUNNEL_KILL_MODE="local"             # how the monitor closes a live channel (rotation, stop, lost tunN): local = ssh -O exit from this server; remote = first kill -9 the sshd of the channel on the VPS through the session, then ssh -O exit
TUNNEL_ROUTING="auto"                # client route through the tunnels: group = a resilient nexthop group, the kernel drops a fallen channel and keeps the rest; route = one multipath route, rebuilt after a fallen channel; auto = group when the kernel supports it, otherwise route

# ---------- ROTATION ----------
ROTATION_DELAY=60                    # pause before rotating the chosen channel, plus a random 0..ROTATION_DELAY seconds
ROTATION_MIN_CHANNEL_INTERVAL=900    # minimum time between rotations of one channel, seconds
ROTATION_MIN_STABLE_TIME=30          # minimum seconds after the channel switched to ONLINE
ROTATION_CYCLE_COUNT=3               # after how many full skipped cycles a channel is rotated anyway
ROTATION_MIN_UNIQUE_HOSTS=2          # how many different VPS hosts rotation needs; 1 = rotate on a single VPS too
ROTATION_ACTIVE_HOSTS_ONLY=1         # 1 = count only enabled hosts, 0 = all
ROTATION_DRAIN_TIMEOUT=300           # maximum seconds to wait for traffic to stop before a rotation
ROTATION_DRAIN_GRACE=60              # how many seconds in a row traffic must stay near zero
ROTATION_DRAIN_THRESHOLD=256         # bytes per second below which traffic counts as nearly stopped
ROTATION_ON_DRAIN_TIMEOUT="force"    # force = rotate after the timeout, skip = skip the rotation

# ---------- SHAPING ----------
SHAPING_RATE="105mbit"               # rate limit per tunnel, in each direction
SHAPING_BURST="1mbit"                # tbf burst size
SHAPING_LATENCY="50ms"               # maximum tbf queue latency
SHAPING_DEFAULT_WEIGHT=20            # tunnel weight in balancing when none is saved

# ---------- WEB ----------
WEB_PANEL=1                          # 1 = web panel: tun --install installs Node.js and the tun-web service; 0 = console only: tun --install skips the panel and leaves an already installed one as it is
WEB_AUTH=1                           # 1 = web panel login with user and password (set with tun --web-password), 0 = no login
WEB_LISTEN="0.0.0.0"                 # address the web panel listens on
WEB_HTTPS=1                          # 1 = panel over HTTPS, 0 = over HTTP (no certificate; push notifications and the panel on a phone home screen need HTTPS)
WEB_HTTPS_PORT=8443                  # HTTPS port; the next port is used by the certificate check
WEB_HTTP_PORT=3000                   # HTTP port when WEB_HTTPS=0
WEB_PUSH=1                           # 1 = push notifications; 0 = none: the panel does not create or load its keys, offers no button and drops the queued messages, tun --install does not ask for the e-mail
WEB_APP_NAME=""                      # the panel installed as an app is named "Tunnel Control <WEB_APP_NAME>" (shortcut, notifications); tun --install writes the host name of the server here; empty = the host name; give each server its own name; up to 48 characters, without / : * ? < > |
WEB_PUSH_LOGOUT_UNSUBSCRIBE=0        # 1 = Log Out in the web panel also unsubscribes that device from push notifications; 0 = the device keeps getting them after Log Out
WEB_PUSH_EMAIL="root@localhost"      # contact e-mail for push notifications; Apple devices (iPhone, iPad, Safari on Mac) need a real address, tun --install asks for it while it is this default
# WARNING: a change of WEB_CERT_ADDRESS or WEB_CERT_SITE_DAYS (or of the CONFIG interface IP while
# WEB_CERT_ADDRESS is empty) issues the site certificate again by itself at the next tunnel start; the devices
# keep trusting it. WEB_CERT_DAYS applies only on tun --web-cert, which creates a new certificate authority
# that has to be installed again on every device.
WEB_CONFIG_BACKUP_PATH="bak"         # folder for the copies of tun.config made before each save in the web panel; relative to the tun folder or absolute (/run/tunnelcontrol/bak keeps them in memory until a reboot); empty = no copies
WEB_CERT_ADDRESS=""                  # panel address in the certificate; empty = IP of the CONFIG interface; a change issues the site certificate again
WEB_CERT_DAYS=3650                   # validity of the panel certificate authority, the certificate installed on the devices, days (applies on tun --web-cert, which creates a new one to install again)
WEB_CERT_SITE_DAYS=825               # validity of the site certificate it issues, days (more than 30); renewed by the panel itself before the end, also while the tunnels run, and at a tunnel start when this value changed (iPhone and Mac reject site certificates of a private authority valid longer than 825 days)

# ---------- UPDATE ----------
UPDATE_URL="https://github.com/rdpex-com/tunnelcontrol/releases/latest/download"   # where tun --update gets the release (VERSION and tunnelcontrol.tar.gz) when not installed from git
UPDATE_CHECK=1                       # 1 = once a day ask UPDATE_URL for the latest release and tell about a newer one (panel banner and System tab, tun --status, a push notification); 0 = never; installs from git are not checked
