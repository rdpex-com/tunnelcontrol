#!/bin/bash
# tun.server <tun> <in_face> <port_ssh> <port_range> <public_ip> <out_face> <local_ip> <remote_ip> <mtu>

if [ "$(basename "$0")" != "tun.start" ]; then
    echo "Error: this script runs on the VPS as /tmp/tun.start. Do not run this script directly."
    exit 1
fi

TUN=${1}
IN_FACE=${2}
PORT_SSH=${3}
PORT_RANGE=${4}
PUBLIC_IP=${5}
OUT_FACE=${6}
LOCAL_IP=${7}
REMOTE_IP=${8}
MTU=${9:-1400}

LOG="/var/log/tun.log"

LOG_INFO() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [tun${TUN}] $1" >> "$LOG"
}

cleanup() {
    LOG_INFO "Cleaning up tun${TUN} configuration!"

    iptables -D FORWARD -i "tun${TUN}" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "tun${TUN}" -j ACCEPT 2>/dev/null || true

    if [ -n "$PUBLIC_IP" ] && [ "$PUBLIC_IP" != "NA" ] && [ "$PUBLIC_IP" != "" ]; then
        iptables -D FORWARD -i "${OUT_FACE}" -o "tun${TUN}" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -i "tun${TUN}" -o "${OUT_FACE}" -j ACCEPT 2>/dev/null || true

        ip route del "${LOCAL_IP}/32" dev "tun${TUN}" table 100 2>/dev/null || true
        ip rule del iif "tun${TUN}" lookup 100 2>/dev/null || true
        ip rule del from "${REMOTE_IP}" lookup 100 2>/dev/null || true
    else
        iptables -D FORWARD -i "${IN_FACE}" -o "tun${TUN}" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -i "tun${TUN}" -o "${IN_FACE}" -j ACCEPT 2>/dev/null || true
    fi
}

vps_check() {
    local c pt sshd_bin

    for c in ip iptables sysctl pgrep systemd-run; do
        command -v "$c" > /dev/null 2>&1 || echo "VPS-PROBLEM: command ${c} not found"
    done

    if [ ! -c /dev/net/tun ]; then
        echo "VPS-PROBLEM: /dev/net/tun not found, tunnels cannot be created (on OpenVZ/LXC enable TUN/TAP in the hosting panel)"
    elif ! ip tuntap add dev tuncheck mode tun > /dev/null 2>&1; then
        echo "VPS-PROBLEM: cannot create a tun interface (tun kernel module missing or not permitted)"
    else
        ip tuntap del dev tuncheck mode tun > /dev/null 2>&1
    fi

    sshd_bin=$(command -v sshd || echo /usr/sbin/sshd)
    pt=$("$sshd_bin" -T 2>/dev/null | awk '$1 == "permittunnel" {print $2}')
    case "$pt" in
        yes|point-to-point|all) ;;
        *) echo "VPS-PROBLEM: sshd PermitTunnel is '${pt:-unknown}', tunnel requests are refused" ;;
    esac

    if [ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" != "1" ]; then
        echo "VPS-PROBLEM: net.ipv4.ip_forward is not 1, traffic from tunnels is not forwarded"
    fi
}

if [ "${TUN_CHECK:-0}" = "1" ]; then
    vps_check
    exit 0
fi

if [ "${TUN_WATCH:-0}" = "1" ]; then
    ip link show "tun${TUN}" > /dev/null 2>&1 || exit 0

    trap cleanup EXIT
    trap 'exit 0' TERM INT HUP

    LOG_INFO "Watching tun${TUN}"

    while ip link show "tun${TUN}" > /dev/null 2>&1; do
        sleep 2
    done

    exit 0
fi

if [ "${TUN}" -eq 0 ]; then
    LOG_INFO "Started with params: in_face=${IN_FACE} ssh=${PORT_SSH} range=${PORT_RANGE} public_ip=${PUBLIC_IP} out_face=${OUT_FACE}"
else
    LOG_INFO "Started with params: tun=${TUN} in_face=${IN_FACE} public_ip=${PUBLIC_IP} out_face=${OUT_FACE} local=${LOCAL_IP} remote=${REMOTE_IP}"
fi

GLOBAL_FLAG="/tmp/tun_initialized"

# ====================== GLOBAL INITIALIZATION ======================
if [ ! -f "$GLOBAL_FLAG" ]; then
    LOG_INFO "First run - performing global initialization"

    sysctl -w net.ipv4.ip_forward=1 >/dev/null

    # Kill old instances
    for pid in $(pgrep -f "tun.start" 2>/dev/null); do
        if [ "$pid" != "$$" ]; then kill -9 "$pid" 2>/dev/null || true; fi
    done

    # Flush iptables
    iptables -F
    iptables -X
    iptables -t nat -F
    iptables -t nat -X
    iptables -t mangle -F
    iptables -t mangle -X
    iptables -Z

    iptables -P FORWARD ACCEPT
    iptables -P OUTPUT ACCEPT
    iptables -P INPUT DROP

    # ==================== PUBLIC IP CONFIG (GLOBAL) ====================
    if [ -n "$PUBLIC_IP" ] && [ "$PUBLIC_IP" != "NA" ] && [ "$PUBLIC_IP" != "" ]; then
        TABLE="100"

        LOG_INFO "Configuring Public IP: $PUBLIC_IP on $OUT_FACE"

        # Add the public IP to the interface
        if ! ip addr show dev "$OUT_FACE" | grep -q "$PUBLIC_IP"; then
            ip addr add "$PUBLIC_IP"/32 dev "$OUT_FACE"
            LOG_INFO "Public IP $PUBLIC_IP added to $OUT_FACE"
        else
            LOG_INFO "Public IP $PUBLIC_IP already exists on $OUT_FACE"
        fi

        # Create the routing table
        while ip rule del lookup $TABLE 2>/dev/null; do :; done
        ip route flush table "$TABLE" 2>/dev/null || true

        DEFAULT_GW=$(ip route show default | awk '{print $3}' | head -n1)

        ip route add default via "$DEFAULT_GW" dev "$OUT_FACE" table "$TABLE"
        ip route add "$PUBLIC_IP"/32 dev "$OUT_FACE" table "$TABLE"

        # SNAT through OUT_FACE
        iptables -t nat -A POSTROUTING -s 10.0.0.0/8 -o "$OUT_FACE" -j SNAT --to-source "$PUBLIC_IP"

        LOG_INFO "Policy routing table $TABLE configured"
    else
        LOG_INFO "No Public IP configured, using default routing"

        # NAT through IN_FACE
        iptables -t nat -A POSTROUTING -o "${IN_FACE}" -j MASQUERADE
    fi

    # ==================== COMMON RULES ====================
    iptables -A INPUT -i lo -j ACCEPT

    iptables -I INPUT 1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    iptables -A INPUT -p icmp -j ACCEPT

    iptables -A INPUT -p tcp --dport 22 -j ACCEPT
    iptables -A INPUT -p tcp --dport "${PORT_SSH}" -j ACCEPT

    ### tun.setup ###

    IFS='-' read -r MIN MAX <<< "${PORT_RANGE}"

    INITIATOR="${SSH_CONNECTION%% *}"

    if [ -n "${INITIATOR}" ]; then
        LOG_INFO "Port range ${MIN}-${MAX} allowed for initiator ${INITIATOR}"
        iptables -t nat -A PREROUTING -i "${IN_FACE}" -s "${INITIATOR}" -p tcp --dport "${MIN}:${MAX}" -j REDIRECT --to-port "${PORT_SSH}"
    else
        LOG_INFO "WARNING: initiator address unknown (not started via ssh) — port range ${MIN}-${MAX} closed for everyone"
    fi

    iptables -A INPUT -p tcp -m multiport --dports "${MIN}:${MAX}" -j DROP

    iptables -S INPUT 2>/dev/null | grep -q -- '--ctstate' \
        || echo "VPS-PROBLEM: conntrack rule was not added, replies to the VPS are dropped"
    iptables -t nat -S POSTROUTING 2>/dev/null | grep -qE -- '-j (SNAT|MASQUERADE)' \
        || echo "VPS-PROBLEM: NAT rule was not added, traffic from tunnels does not reach the internet"
    iptables -S INPUT 2>/dev/null | grep -q -- '--dports' \
        || echo "VPS-PROBLEM: multiport DROP rule was not added, the port range stays open for everyone"
    if [ -n "${INITIATOR}" ]; then
        iptables -t nat -S PREROUTING 2>/dev/null | grep -q -- '-j REDIRECT' \
            || echo "VPS-PROBLEM: REDIRECT rule was not added, tunnels on random ports cannot connect"
    fi

    vps_check

    touch "$GLOBAL_FLAG"

    LOG_INFO "Global initialization completed"

    echo "Loaded"
    exit
else
    LOG_INFO "Global rules already initialized - skipping"
fi

# ====================== TUNNEL SPECIFIC ======================
WATCH_UNIT="tun-watch-${TUN}"
systemctl stop "${WATCH_UNIT}" 2>/dev/null || true

{
    ip link set "tun${TUN}" up
    ip addr replace "${REMOTE_IP}/32" peer "${LOCAL_IP}/32" dev "tun${TUN}"
    ip link set "tun${TUN}" mtu "${MTU}"
} 2>/dev/null || true

# Forwarding rules
for c in D A; do
    iptables "-${c}" FORWARD -i "tun${TUN}" -j ACCEPT 2>/dev/null || true
    iptables "-${c}" FORWARD -o "tun${TUN}" -j ACCEPT 2>/dev/null || true
done

# ====================== POLICY ROUTING FOR THE TUNNEL ======================
if [ -n "$PUBLIC_IP" ] && [ "$PUBLIC_IP" != "NA" ] && [ "$PUBLIC_IP" != "" ]; then
    # Forwarding rules
    for c in D A; do
        iptables "-${c}" FORWARD -i "${OUT_FACE}" -o "tun${TUN}" -j ACCEPT 2>/dev/null || true
        iptables "-${c}" FORWARD -i "tun${TUN}" -o "${OUT_FACE}" -j ACCEPT 2>/dev/null || true
    done

    TABLE="100"
    ip route replace "${LOCAL_IP}/32" dev "tun${TUN}" table "$TABLE" 2>/dev/null || true
    ip rule del iif "tun${TUN}" lookup "$TABLE" 2>/dev/null || true
    ip rule add iif "tun${TUN}" lookup "$TABLE" prio 1000 2>/dev/null || true
    ip rule del from "${REMOTE_IP}" lookup "$TABLE" 2>/dev/null || true
    ip rule add from "${REMOTE_IP}" lookup "$TABLE" prio 900 2>/dev/null || true

    LOG_INFO "Policy routing rules added for tun${TUN} (table $TABLE)"
else
    # Forwarding rules
    for c in D A; do
        iptables "-${c}" FORWARD -i "${IN_FACE}" -o "tun${TUN}" -j ACCEPT 2>/dev/null || true
        iptables "-${c}" FORWARD -i "tun${TUN}" -o "${IN_FACE}" -j ACCEPT 2>/dev/null || true
    done

    LOG_INFO "No Public IP configured, skipping policy routing for tun${TUN}"
fi

LOG_INFO "Tunnel tun${TUN} configured successfully (${LOCAL_IP} ↔ ${REMOTE_IP})"

if command -v systemd-run > /dev/null 2>&1; then
    systemd-run --unit "${WATCH_UNIT}" --collect --quiet --setenv=TUN_WATCH=1 \
        /bin/bash "$(readlink -f "$0")" "$@" > /dev/null 2>&1 \
        || LOG_INFO "Failed to start ${WATCH_UNIT}, tun${TUN} rules will stay until next global initialization"
else
    LOG_INFO "systemd-run not found, tun${TUN} rules will stay until next global initialization"
fi

echo "PID:$PPID"